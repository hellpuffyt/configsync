# Example development environment configuration (.env format).
# All values below are placeholders for demonstration purposes only.

APP_NAME=widget-service
LOG_LEVEL=debug

# Expected to differ per environment (see rules.yaml: expected_variance).
DATABASE_URL=postgres://dev-db.internal:5432/widgets
DB_HOST=dev-db.internal

# Secret-pattern keys: configsync will never print these values in any
# report, only whether they differ across environments.
DB_PASSWORD=dev-local-placeholder-pw
API_KEY=dev-fake-key-0000000000

# Must be identical everywhere (see rules.yaml: must_match). In this file
# FEATURE_NEW_UI is stored as the string "true" -- watch for the
# type-differs finding once compared against the YAML/JSON environments.
FEATURE_NEW_UI=true
REQUEST_TIMEOUT_MS="3000"
